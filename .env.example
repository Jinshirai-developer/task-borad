# Configuration reference: ASP.NET Core does not automatically load .env.
# Configure hosting environment variables/secrets or use docker --env-file.
# Do not source this file as a shell script or commit a populated .env.

# Local Compose PostgreSQL only, not a managed production DB.
# If changed, also update the app connection string. Existing DB volumes keep
# their original credentials; editing these values does not rotate them.
TASKAPI_DB_NAME=taskdb
TASKAPI_DB_USER=taskuser
TASKAPI_DB_PASSWORD=change-me
TASKAPI_DB_PORT=5432

# Public runtime: replace example values and supply real secrets.
ASPNETCORE_ENVIRONMENT=Production
AllowedHosts=tasks.example.com
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=taskdb;Username=taskuser;Password=change-me;SSL Mode=Require

# Exact trusted HTTPS origin: no path, query, fragment or credentials.
Authentication__PublicBaseUrl=https://tasks.example.com
# Mount a persistent, access-restricted, encrypted-at-rest volume here.
# Share the key ring across instances and include it in protected backups.
Authentication__KeyRingPath=/var/lib/task-board/keys

# Enable only when the app port is private and the managed proxy overwrites
# forwarded headers. Otherwise explicitly configure trusted proxies/networks.
ASPNETCORE_FORWARDEDHEADERS_ENABLED=false

# Production SMTP. Blank fields intentionally prevent public startup.
# Security: StartTls or SslOnConnect (not None). Credentials are secrets.
Email__Host=
Email__Port=587
Email__Security=StartTls
Email__Username=
Email__Password=
Email__FromAddress=
Email__FromName=Task Board

# Real legal information: intentionally blank until the operator decides.
# Nonempty values alone are not legal approval or production verification.
Legal__OperatorName=
Legal__ContactEmail=
# Include hosting/DB provider and relevant processing/storage regions.
Legal__HostingProvider=
# Include actual delivery provider and relevant processing regions.
Legal__EmailProvider=
# Describe actual durations and deletion/rotation procedures.
Legal__LogRetention=
Legal__BackupRetention=

# Bound demo growth; false pauses only new registrations.
Registration__Enabled=true
Registration__MaxUsers=100

# Optional Stripe SANDBOX ONLY. Never supply live keys or real card details.
# Enabled=true requires all three values; matching test Price must be JPY/month/500.
Billing__Enabled=false
Billing__MonthlyYen=500
Billing__SecretKey=
Billing__WebhookSecret=
Billing__PriceId=

# Optional Google login. Store real values only in a private environment file/secret store.
# Register exactly {Authentication__PublicBaseUrl}/signin-google as the OAuth redirect URI.
Authentication__Google__Enabled=false
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
