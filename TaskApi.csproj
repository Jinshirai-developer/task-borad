<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**;.local/**;portfolio/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Stripe.net" Version="52.4.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="desktop/**/*.cs" />
    <Content Remove="desktop/**" />
    <None Remove="desktop/**" />
    <Compile Remove="TaskApi.Tests/**/*.cs" />
    <Content Remove="TaskApi.Tests/**" />
    <None Remove="TaskApi.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <Content Include="frontend/assets/brand/google-g.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Remove="frontend/assets/pet/sources/**;frontend/assets/pet/drafts/**;frontend/assets/pet/archive/**" />
    <None Update="frontend/assets/pet/sources/**;frontend/assets/pet/drafts/**;frontend/assets/pet/archive/**">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
    <Content Include="frontend/*.html;frontend/*.css;frontend/*.js;frontend/assets/pet/portfolio-*-web.png;frontend/assets/pet/portfolio-*-atlas-v2-alpha.png;frontend/assets/pet/portfolio-cat-*-v3.png;frontend/assets/pet/rewards-v2/*/*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
