<Window x:Class="TaskBoard.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Task Board" Width="1280" Height="860" MinWidth="900" MinHeight="640"
 FontFamily="Yu Gothic UI, Meiryo" FontSize="14" Background="#F0F5F1"
 WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#DCE6DF" BorderThickness="0,0,0,1" Padding="18,0">
   <DockPanel LastChildFill="True">
    <TextBlock Text="Task Board" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" Margin="0,0,20,0"/>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="BrowserLoginButton" Content="ブラウザーでログイン" Click="BrowserLogin_Click" IsEnabled="False"/>
     <Button Content="再読み込み" Click="Reload_Click"/>
     <Button x:Name="OnlineButton" Content="オンラインに戻る" Click="Connect_Click" Visibility="Collapsed"/>
     <Button x:Name="DemoButton" Content="お試し" Click="Demo_Click" IsEnabled="False"/>
    </StackPanel>
    <TextBlock x:Name="ServerLabel" Text="for Windows" Foreground="#6C7D70" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
   </DockPanel>
  </Border>
  <Grid Grid.Row="1">
   <Grid x:Name="BrowserHost" Visibility="Collapsed"/>
   <Border x:Name="ConnectionPanel" Background="White" BorderBrush="#DCE6DF" BorderThickness="1" CornerRadius="16"
    MaxWidth="590" Padding="36" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28">
    <StackPanel>
     <TextBlock x:Name="ConnectionHeading" Text="Task Boardを開いています" FontSize="26" FontWeight="Bold" Foreground="#263E2E"/>
     <TextBlock x:Name="ConnectionMessage" Text="まもなく画面が表示されます。" TextWrapping="Wrap" Margin="0,14,0,26" Foreground="#5F7063" AutomationProperties.LiveSetting="Polite"/>
     <ProgressBar x:Name="ConnectionProgress" IsIndeterminate="True" Height="4" Margin="0,0,0,12"/>
     <Button x:Name="RetryButton" Content="再試行" Background="#345C46" Foreground="White" Click="Connect_Click" IsDefault="True" Padding="16,12" Visibility="Collapsed"/>
     <Button x:Name="OfflineButton" Content="お試しモードを開く" Click="Demo_Click" Padding="16,12" Visibility="Collapsed"/>
     <Button x:Name="RuntimeButton" Content="WebView2を入手する" Visibility="Collapsed" Click="Runtime_Click"/>
    </StackPanel>
   </Border>
   <Border x:Name="SignInPanel" Visibility="Collapsed" Background="White" BorderBrush="#DCE6DF" BorderThickness="1" CornerRadius="16"
    Width="520" Padding="36" HorizontalAlignment="Center" VerticalAlignment="Center">
    <StackPanel>
     <TextBlock Text="ブラウザーでログイン" FontSize="25" FontWeight="Bold"/>
     <TextBlock Text="開いたブラウザーでログインし、次のコードと一致することを確認して承認してください。" Margin="0,16,0,20"/>
     <TextBlock x:Name="SignInCode" FontFamily="Consolas" FontSize="38" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,20"/>
     <Button Content="認証画面をもう一度開く" Click="ReopenLogin_Click"/>
     <Button Content="キャンセル" Click="CancelLogin_Click"/>
    </StackPanel>
   </Border>
  </Grid>
  <TextBlock Grid.Row="2" x:Name="StatusText" Text="Task Boardを開いています…" Margin="18,4" FontSize="12" Foreground="#526757" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
 </Grid>
</Window>
